# Endpoint that receives every form submission (inquiries, bookings, interest, orders) as JSON.
# e.g. a Formspree/Getform URL, a Google Apps Script web app, or your own API.
# Without it, submissions are only logged to the browser console.
VITE_FORM_ENDPOINT=

# Paystack public key for online payment (Mobile Money and card) at checkout.
# Use pk_test_… while testing and pk_live_… once your Paystack business is approved.
# Only the PUBLIC key belongs here; never put the secret key (sk_…) in this file.
# Without it, checkout offers manual Mobile Money transfer only.
VITE_PAYSTACK_PUBLIC_KEY=
